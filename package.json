{
  "name": "WikiShield",
  "version": "1.0.8",
  "description": "WikiShield Application",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuniZunie/WikiShield-App.git"
  },
  "publish": {
    "provider": "github",
    "owner": "LuniZunie",
    "repo": "WikiShield-App"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:all": "electron-forge make --platform=win32,darwin,linux",
    "test": "electron --trace-warnings .",
    "build": "node build.js",
    "version": "node scripts/sync-version.js",
    "publish": "node scripts/publish-release.js",
    "publish:win": "electron-builder --win --publish always",
    "publish:mac": "electron-builder --mac --publish always",
    "publish:linux": "electron-builder --linux --publish always",
    "build:local": "electron-builder --publish never"
  },
  "keywords": [],
  "author": "WikiShield Team",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-deb": "^7.5.0",
    "@electron-forge/maker-dmg": "^7.5.0",
    "@electron-forge/maker-rpm": "^7.5.0",
    "@electron-forge/maker-squirrel": "^7.5.0",
    "@electron-forge/maker-zip": "^7.5.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "electron-winstaller": "^5.4.0"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "WikiShield",
        "executableName": "wikishield",
        "icon": "./assets/icon",
        "appBundleId": "com.ws.app",
        "win32metadata": {
          "CompanyName": "WikiShield Team",
          "FileDescription": "WikiShield Application",
          "ProductName": "WikiShield",
          "FileVersion": "1.0.8",
          "ProductVersion": "1.0.8"
        },
        "appVersion": "1.0.8",
        "buildVersion": "1.0.8"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "WikiShield"
          },
          "platforms": [
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "linux",
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {},
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {},
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "format": "ULFO"
          },
          "platforms": [
            "darwin"
          ]
        }
      ]
    }
  },
  "build": {
    "appId": "com.ws.app",
    "productName": "WikiShield",
    "generateUpdatesFilesForAllChannels": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "!**/*.ts",
      "!*.code-workspace",
      "!LICENSE.md",
      "!package-lock.json",
      "!e2e/",
      "!hooks/",
      "!angular.json",
      "!_config.yml",
      "!karma.conf.js",
      "!tsconfig.json",
      "!tslint.json",
      "!out/",
      "!build/",
      "!build.js",
      "!dist/",
      "!scripts/"
    ],
    "afterPack": "./scripts/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "WikiShield Team"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WikiShield"
    },
    "publish": {
      "provider": "github",
      "owner": "LuniZunie",
      "repo": "WikiShield-App",
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseNotesFile": ".github/RELEASE_NOTES.md"
    }
  }
}
