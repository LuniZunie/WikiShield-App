{
  "name": "WikiShield",
  "version": "2.0.3",
  "description": "WikiShield is an anti-vandalism tool for Wikipedia.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuniZunie/WikiShield-App.git"
  },
  "publish": {
    "provider": "github",
    "owner": "LuniZunie",
    "repo": "WikiShield-App"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "electron . --trace-warnings",
    "build": "electron-builder --publish never",
    "build-web": "webpack --mode production",
    "sync-version": "node scripts/sync-version.js",
    "publish": "node scripts/publish-release.js",
    "publish:win": "electron-builder --win --publish always",
    "publish:mac": "electron-builder --mac --publish always",
    "publish:linux": "electron-builder --linux --publish always",
    "build-web:dev": "webpack serve --mode development",
    "build-web:readable": "cross-env READABLE=true webpack --mode production"
  },
  "keywords": [
    "Electron",
    "WikiShield",
    "Wikipedia",
    "MediaWiki",
    "Anti-Vandalism",
    "ORES"
  ],
  "author": "WikiShield Team",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-deb": "^7.5.0",
    "@electron-forge/maker-dmg": "^7.5.0",
    "@electron-forge/maker-rpm": "^7.5.0",
    "@electron-forge/maker-squirrel": "^7.5.0",
    "@electron-forge/maker-zip": "^7.5.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "electron-winstaller": "^5.4.0",
    "terser-webpack-plugin": "^5.3.10",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@octokit/rest": "^22.0.1",
    "babel-loader": "^10.1.1",
    "cross-env": "^10.1.0",
    "discord-rpc": "^4.0.1",
    "electron-log": "^5.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.2",
    "node-fetch": "^2.7.0",
    "webpack": "^5.107.2"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "WikiShield",
        "executableName": "wikishield",
        "icon": "./assets/icon",
        "appBundleId": "com.ws.app",
        "win32metadata": {
          "CompanyName": "WikiShield Team",
          "FileDescription": "WikiShield Application",
          "ProductName": "WikiShield",
          "FileVersion": "2.0.3",
          "ProductVersion": "2.0.3"
        },
        "appVersion": "2.0.3",
        "buildVersion": "2.0.3"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "WikiShield"
          },
          "platforms": [
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "linux",
            "win32"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {},
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {},
          "platforms": [
            "linux"
          ]
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "format": "ULFO"
          },
          "platforms": [
            "darwin"
          ]
        }
      ]
    }
  },
  "build": {
    "appId": "com.ws.app",
    "productName": "WikiShield",
    "generateUpdatesFilesForAllChannels": true,
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "files": [
      "**/*",
      "ores_score.py",
      "python-installer.js",
      "local-ores.js",
      "!**/*.ts",
      "!*.code-workspace",
      "!LICENSE.md",
      "!package-lock.json",
      "!e2e/",
      "!hooks/",
      "!angular.json",
      "!_config.yml",
      "!karma.conf.js",
      "!tsconfig.json",
      "!tslint.json",
      "!out/",
      "!build/",
      "!build.js",
      "!dist/",
      "!scripts/",
      "node_modules/**"
    ],
    "afterPack": "./scripts/after-pack.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "WikiShield Team"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WikiShield",
      "artifactName": "WikiShield-Setup-2.0.3.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "LuniZunie",
      "repo": "WikiShield-App",
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseNotesFile": "README.md"
    }
  }
}
