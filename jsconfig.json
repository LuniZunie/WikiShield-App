{
    "compilerOptions": {
        "target": "ES2017",
        "module": "ESNext",
        "lib": [ "ES2017", "DOM" ],
        "allowJs": true,
        "checkJs": false,
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": [
        "global/**/*",
        "src/common/**/*",
        "src/wikishield/**/*",
        "wikipedia/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "dist-web",
        "build",
        "out",
        "errors",
        "scripts",
        "preload",
        "app",
        "assets",
        "webpack.config.js",
    ]
}